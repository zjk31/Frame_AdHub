<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+：平台 SplashScreen API，系统启动页背景与我们的 SplashScreen composable 一致 -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground">#FFF5F5F5</item>
        <item name="android:statusBarColor">#FFF5F5F5</item>
        <item name="android:navigationBarColor">#FFF5F5F5</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
