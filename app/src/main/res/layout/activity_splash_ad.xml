<?xml version="1.0" encoding="utf-8"?>
<!--
  开屏广告 Activity 布局。
  根背景与系统启动页保持一致；广告渲染前展示品牌 loading panel。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_ad_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launch_bg">

    <!-- 品牌 loading panel：与系统启动页视觉一致，避免切换跳变 -->
    <LinearLayout
        android:id="@+id/splash_loading_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/launch_bg">

        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textColor="#FF6B35"
            android:textStyle="bold" />

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#FF8A65" />
    </LinearLayout>
</FrameLayout>
